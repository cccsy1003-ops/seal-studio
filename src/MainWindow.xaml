<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="印章2 · 阴刻 / 阳刻" Width="1240" Height="860" MinWidth="1040" MinHeight="690" WindowStartupLocation="Manual" ResizeMode="CanResize" WindowStyle="SingleBorderWindow" ShowInTaskbar="True" Background="#F5F3EF" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#252D2B">
<Window.Resources>
<Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8DCD7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="ComboBox"><Setter Property="Padding" Value="7,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="34"/><Setter Property="Cursor" Value="Hand"/></Style>
<Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,0,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
<Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,20,0,10"/></Style>
<Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#68726B"/><Setter Property="Margin" Value="0,8,0,5"/></Style>
</Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
<Border Background="#243C33" Padding="28,15"><Grid><StackPanel><TextBlock Text="印章2" Foreground="#FFFCF4" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="输入文字 · 选择字形 · 生成可雕刻印面" Foreground="#BCD0C1" Margin="0,3,0,0"/></StackPanel><TextBlock Text="厘米尺寸 / 离线使用" Foreground="#D5E5D7" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
<Grid Grid.Row="1" Margin="18,18,18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="345"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="White" CornerRadius="10" BorderBrush="#E2E3DC" BorderThickness="1"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,18,20"><StackPanel>
<TextBlock Text="01  印章文字" Style="{StaticResource Heading}"/>
<TextBox x:Name="StampText" Text="春风得意" AcceptsReturn="True" TextWrapping="Wrap" Height="78" VerticalScrollBarVisibility="Auto" FontSize="22" MaxLength="400"/>
<Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ToTraditional" Content="简 → 繁" ToolTip="将输入文字转为繁体；篆体多采用繁体字形，请核对多义字" Margin="0,0,4,0"/><Button x:Name="RestoreText" Grid.Column="1" Content="撤销转繁体" IsEnabled="False" Margin="4,0,0,0"/></Grid>
<TextBlock Text="常用篆刻风格" Style="{StaticResource FieldLabel}"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="HanStyle" Content="汉白文" ToolTip="王汉宗印篆体繁 + 阴刻；印篆风格近似" Margin="0,0,4,0"/><Button x:Name="XiaoStyle" Grid.Column="1" Content="小篆朱文" ToolTip="崇羲篆体 + 阳刻" Margin="4,0,0,0"/></Grid>
<TextBlock x:Name="FontHelp" TextWrapping="Wrap" FontSize="11" Foreground="#66796B" Margin="0,6,0,0"/>
<TextBlock Text="字体" Style="{StaticResource FieldLabel}"/>
<TextBox x:Name="FontSearch" ToolTip="输入字体名称查找，如：楷、隶、篆"/>
<TextBlock Text="↑ 搜索字体名称；清空可看全部" FontSize="11" Foreground="#8A918A" Margin="0,3,0,5"/>
<ComboBox x:Name="FontChoice" MaxDropDownHeight="300"/>
<Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ImportFont" Content="＋ 导入字体" Margin="0,0,4,0"/><Button x:Name="ReloadFonts" Grid.Column="1" Content="刷新字体" Margin="4,0,0,0"/></Grid>
<TextBlock x:Name="FontCount" Foreground="#7F8880" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
<TextBlock Text="02  排版与效果" Style="{StaticResource Heading}"/>
<TextBlock Text="印章类型" Style="{StaticResource FieldLabel}"/>
<ComboBox x:Name="Mode"><ComboBoxItem Content="阳刻 / 朱文 · 文字凸起"/><ComboBoxItem Content="阴刻 / 白文 · 文字凹下"/></ComboBox>
<TextBlock Text="排字方式" Style="{StaticResource FieldLabel}"/>
<ComboBox x:Name="Layout"><ComboBoxItem Content="传统章法 · 竖排右起（自动分列）"/><ComboBoxItem Content="横排左起（自动换行）"/><ComboBoxItem Content="按输入换行 · 横排"/><ComboBoxItem Content="每行一列 · 竖排右起"/></ComboBox>
<Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="自动分列：列数" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Columns" Text="2"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="文字大小（20～100%）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="TextSize" Text="92"/></StackPanel></Grid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="字间留白（0～40%）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="Spacing" Text="6"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="内边距（cm）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MarginSize" Text="0.18"/></StackPanel></Grid>
<CheckBox x:Name="Stretch" Content="字形铺满格子（适合篆刻）" IsChecked="True"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><CheckBox x:Name="BorderOn" Content="阳刻边框 / 阴刻留边" IsChecked="True"/><TextBox x:Name="BorderSize" Grid.Column="1" Text="0.06" ToolTip="边框宽度，单位 cm"/></Grid>
<TextBlock Text="03  实际尺寸" Style="{StaticResource Heading}"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,5,0"><TextBlock Text="宽（cm）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="WidthCm" Text="3"/></StackPanel><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="高（cm）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HeightCm" Text="3"/></StackPanel></Grid>
<CheckBox x:Name="Square" Content="正方形（宽高同步）" IsChecked="True"/>
<TextBlock Text="清晰度（DPI）" Style="{StaticResource FieldLabel}"/>
<ComboBox x:Name="Dpi" IsEditable="True" Text="600"><ComboBoxItem Content="300"/><ComboBoxItem Content="600"/><ComboBoxItem Content="1200"/></ComboBox>
<TextBlock Text="04  雕刻与保存" Style="{StaticResource Heading}"/>
<TextBlock Text="反转方式在右侧预览上方选择。" Foreground="#66796B" Margin="0,0,0,8"/>
<ComboBox x:Name="BlackMeaning"><ComboBoxItem Content="黑色 = 雕刻去除区域（默认）"/><ComboBoxItem Content="黑色 = 保留凸起区域"/></ComboBox>
<TextBlock Text="保存位置" Style="{StaticResource FieldLabel}"/>
<TextBox x:Name="OutputDir" Text="D:\印章2\生成图片"/>
<Button x:Name="PickDir" Content="选择保存文件夹…" Margin="0,6,0,0"/>
<CheckBox x:Name="AlsoBmp" Content="同时导出 BMP（兼容旧雕刻软件）"/>
<TextBlock Text="已加入印篆、小篆字库。支持 TTF / OTF / TTC。篆体缺简体字时可点“简 → 繁”，转换后请核对字义。" TextWrapping="Wrap" FontSize="11" Foreground="#7F8880" Margin="0,12,0,0"/>
</StackPanel></ScrollViewer></Border>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="一眼确认，刻印方向" FontSize="23" FontWeight="SemiBold" Margin="2,0,0,6"/><TextBlock x:Name="SizeInfo" Foreground="#69786E" Margin="2,0,0,10"/>
<Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="反转方式" VerticalAlignment="Center" FontWeight="SemiBold"/><ComboBox x:Name="MirrorMode" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="整章左右反转 · 用于整块刻章" Tag="1"/><ComboBoxItem Content="每个字单独左右反转 · 字的位置不变" Tag="2"/><ComboBoxItem Content="只反转指定字 · 在下方勾选" Tag="3"/><ComboBoxItem Content="不反转 · 保持输入方向" Tag="0"/></ComboBox></Grid>

<StackPanel x:Name="CharacterPanel" Visibility="Collapsed" Margin="0,0,0,10"><TextBlock Text="勾选要左右反转的字（按输入顺序；不计空格和换行，修改文字后需重选）" FontSize="11" Foreground="#66796B" TextWrapping="Wrap"/><ScrollViewer MaxHeight="74" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="CharacterChoices"/></ScrollViewer></StackPanel>
</StackPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="White" BorderBrush="#E0E2DB" BorderThickness="1" CornerRadius="10" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="盖印效果" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="整块盖印后的实际方向" Foreground="#7A847C" FontSize="12" Margin="0,5,0,0"/></StackPanel><Border Grid.Row="1" Margin="0,20" Background="#FAF8F2" Padding="15"><Image x:Name="PaperPreview" Stretch="Uniform" StretchDirection="Both" RenderOptions.BitmapScalingMode="HighQuality"/></Border><TextBlock Grid.Row="2" Text="红色为盖印着色区域" Foreground="#A4473A" TextAlignment="Center" FontSize="12"/></Grid></Border>
<Border Grid.Column="2" Background="White" BorderBrush="#CED8CF" BorderThickness="1" CornerRadius="10" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="雕刻图" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="MirrorInfo" Foreground="#467156" FontSize="12" Margin="0,5,0,0"/></StackPanel><Border Grid.Row="1" Margin="0,20" Background="#F2F4F0" Padding="15"><Image x:Name="CutPreview" Stretch="Uniform" StretchDirection="Both" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border><TextBlock Grid.Row="2" x:Name="BlackInfo" Foreground="#52685B" TextAlignment="Center" FontSize="12"/></Grid></Border>
</Grid>
<Border Grid.Row="2" Background="#E8EEE7" CornerRadius="8" Padding="16,12" Margin="0,14,0,14"><TextBlock x:Name="Hint" TextWrapping="Wrap" Foreground="#46614D" LineHeight="22"/></Border>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="PNG · 原始尺寸 · 黑白纯色" FontWeight="SemiBold"/><TextBlock Text="附带盖印参考图和尺寸说明" Foreground="#7D867F" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button x:Name="OpenOutput" Grid.Column="1" Content="打开输出文件夹" Margin="0,0,10,0"/><Button x:Name="Export" Grid.Column="2" Content="生成并保存到 D 盘" Background="#2B5941" Foreground="White" FontSize="16" FontWeight="SemiBold" Padding="15,16"/></Grid>
</Grid></Grid>
<Border Grid.Row="2" Background="#ECEDE6" Padding="20,10"><TextBlock x:Name="Status" Text="准备就绪" TextTrimming="CharacterEllipsis"/></Border>
</Grid></Window>